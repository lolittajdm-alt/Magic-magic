{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "magic-magic-orders",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    "SHOP_URL": "https://lolittajdm-alt.github.io/Magic-magic/",
    "ALLOWED_ORIGINS": "https://lolittajdm-alt.github.io",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "magic-magic-orders",
      "database_id": "7f52e10f-6edb-4194-baa1-b9b4455c80bf",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": false },
}
